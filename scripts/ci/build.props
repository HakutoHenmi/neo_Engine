<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_NeoCiRoot>$(MSBuildThisFileDirectory)..\..\artifacts\ci\</_NeoCiRoot>
    <OutDir>$(_NeoCiRoot)bin\$(Configuration)\</OutDir>
    <IntDir>$(_NeoCiRoot)obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
    <_NeoCiAssimp>$(_NeoCiRoot)deps\assimp</_NeoCiAssimp>
    <_NeoCiAssimp Condition="'$(Configuration)'=='Debug'">$(_NeoCiRoot)deps\assimp-Debug</_NeoCiAssimp>
    <_NeoCiZlib>zlibstatic.lib</_NeoCiZlib>
    <_NeoCiZlib Condition="'$(Configuration)'=='Debug'">zlibstaticd.lib</_NeoCiZlib>
    <PackageWorkDirectory>$(_NeoCiRoot)package</PackageWorkDirectory>
    <PackageDirectXTexLibrary>$(_NeoCiRoot)bin\Release\DirectXTex.lib</PackageDirectXTexLibrary>
    <NtcRuntimePath>$(_NeoCiRoot)deps\ntc\libntc.dll</NtcRuntimePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <!-- Use the headers built with this library, rather than a machine-local SDK. -->
    <ClCompile>
      <AdditionalIncludeDirectories>$(_NeoCiAssimp)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(_NeoCiAssimp)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(_NeoCiZlib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
