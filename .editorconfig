root = true

[{Engine,Game,tests}/**.{cpp,h,hpp,c,cc,cxx,hxx,inl}]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Engine/ThirdParty/**]
charset = unset
indent_style = unset
indent_size = unset
tab_width = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
